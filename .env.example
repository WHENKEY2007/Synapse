# ==============================================================================
# Synapse Self-Healing Knowledge Base - Environment Configuration
# ==============================================================================

# Server Configuration
SYNAPSE_ENV=production
SYNAPSE_HOST=0.0.0.0
SYNAPSE_PORT=8000
SYNAPSE_DEBUG=false

# Security & Authentication
SYNAPSE_JWT_SECRET=synapse-production-enterprise-secret-key-2026-png4-secure-replace-me
SYNAPSE_TOKEN_EXPIRY_SECONDS=86400

# Database Configuration
SYNAPSE_DB_PATH=/app/data/synapse.db

# CORS Configuration (Comma-separated origins)
SYNAPSE_CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,https://synapse.internal.corp

# Reasoning & Auto-Healing Settings
SYNAPSE_DEFAULT_AUTO_HEAL_THRESHOLD=95
SYNAPSE_ALLOW_AUTO_HEAL=true

# External Notifications (Optional Slack webhook for incident alerts)
SYNAPSE_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

